[Unit]
Description=Upload verified encrypted Wovie MongoDB snapshot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=wovie
Group=wovie
WorkingDirectory=/opt/wovie
EnvironmentFile=/etc/wovie/wovie.env
ExecStart=/opt/wovie/.venv/bin/python -m wovie.snapshot upload
PrivateTmp=true
UMask=0077
NoNewPrivileges=true
