[Unit]
Description=Wovie Telegram catalog bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=wovie
Group=wovie
WorkingDirectory=/opt/wovie
EnvironmentFile=/etc/wovie/wovie.env
Environment=MALLOC_ARENA_MAX=2
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TMPDIR=/var/lib/wovie/tmp
StateDirectory=wovie
StateDirectoryMode=0700
ExecStartPre=/usr/bin/mkdir -p /var/lib/wovie/tmp
ExecStart=/opt/wovie/.venv/bin/python -m wovie
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
MemoryHigh=160M
MemoryMax=192M
TasksMax=64

[Install]
WantedBy=multi-user.target
