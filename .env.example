# Required. Never commit the real .env.
BOT_TOKEN=
ADMINS=[123456789]
MONGO_URI=mongodb://127.0.0.1:27017/wovie
MONGO_DB=wovie

# Additional distinct dedicated catalog databases; primary is always required.
CATALOG_URIS=[]

# Authorized history/private indexing: Telethon StringSession, not Pyrogram.
API_ID=
API_HASH=
SESSION_STRING=

BOT_NAME=Wovie
PUBLIC_SEARCH=true
PAGE_SIZE=8
RATE_LIMIT=12
DAILY_LIMIT=0
MAX_FILE_SIZE=0
REQUIRED_CHANNELS=[]
DELETE_AFTER=0
PROTECT_CONTENT=false
TMDB_API_KEY=

# Price 0 disables sales. HTTPS support URL required for paid plans.
PREMIUM_STARS=0
PREMIUM_DAYS=30
SUPPORT_URL=

# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Preserve key separately from VPS and encrypted archives.
BACKUP_KEY=
BACKUP_CHAT=
LOG_LEVEL=INFO
POLL_TIMEOUT=30
JOB_INTERVAL=1

# Optional providers: docs/EXTENSIONS.md.
OMDB_API_KEY=
KINO_API_KEY=
SEERR_URL=
SEERR_API_KEY=
DRIVE_ACCESS_TOKEN=
DRIVE_ID=

# Separate web process: docs/WEB.md.
WEB_PUBLIC_URL=
WEB_SOURCE_IDS=[]
WEB_SESSION_STRING=
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_MAX_STREAMS=1
WEB_BYTES_PER_SECOND=2097152

# Provider workflows: docs/PROVIDERS.md. Enable only what you use.
SHOWTIMES_REGION=
WATCH_REGION=US
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DAILY_REQUESTS=50
REAL_DEBRID_TOKEN=
PUBLISH_URL=
PUBLISH_TOKEN=

# Timed access verification: docs/OPERATORS.md. Disabled by default.
VERIFICATION_REQUIRED=false
VERIFICATION_TTL=43200
VERIFICATION_MIN_SECONDS=10
SHORTENER_API_URL=
SHORTENER_API_KEY=

# Optional custom Bot API for the polling worker. Leave blank for Telegram.
BOT_API_BASE_URL=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Memory profile measured on glibc Linux; other workloads need measurement.
MALLOC_ARENA_MAX=2

# Optional separate recovery host: docs/RECOVERY.md.
SNAPSHOT_REMOTE=
RCLONE_CONFIG=
ARCHIVE_SESSION_STRING=

# Optional separate Discord process: docs/INTERFACES.md.
DISCORD_TOKEN=
DISCORD_GUILD_IDS=
DISCORD_PUBLIC_CATALOG=false
TELEGRAM_BOT_USERNAME=
# Optional warning margin for remote Mongo data + index storage. Zero disables the ceiling.
CATALOG_MAX_MIB=0

# Optional owner Mini App uploads (MiB, 0 disables).
WEB_UPLOAD_MIB=0

# Optional offline Drive OAuth and bounded AI cache.
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
AI_MAX_OUTPUT_TOKENS=192
AI_CACHE_SLOTS=512
AI_CACHE_SECONDS=3600

# Isolated staging MongoDB, used only by snapshot drill.
DRILL_MONGO_URI=
